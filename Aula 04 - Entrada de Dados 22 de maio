1.

```dart
import 'dart:io';

void main() {
  print("Nome:");
  String nome = stdin.readLineSync()!;

  print("Turma:");
  String turma = stdin.readLineSync()!;

  print("Idade:");
  int idade = int.parse(stdin.readLineSync()!);

  print("Nota 1:");
  double nota1 = double.parse(stdin.readLineSync()!);

  print("Nota 2:");
  double nota2 = double.parse(stdin.readLineSync()!);

  double media = (nota1 + nota2) / 2;

  print("Nome: $nome");
  print("Turma: $turma");
  print("Idade: $idade");
  print("Nota 1: $nota1");
  print("Nota 2: $nota2");
  print("Média: $media");

  if (media >= 7) {
    print("Aprovado");
  } else {
    print("Recuperação");
  }
}
```

