// 1
class Produto {
  String _nome;
  double _preco;
  int _quantidade;

  Produto(this._nome, this._preco, this._quantidade);

  String get nome => _nome;
  set nome(String valor) => _nome = valor;

  double get preco => _preco;
  set preco(double valor) => _preco = valor;

  int get quantidade => _quantidade;
  set quantidade(int valor) => _quantidade = valor;

  void mostrarDados() {
    print("Produto: $_nome | Preço: R\$ $_preco | Qtd: $_quantidade");
  }

  void calcularTotal() {
    double total = _preco * _quantidade;
    print("Total em estoque de $_nome: R\$ $total");
  }
}

