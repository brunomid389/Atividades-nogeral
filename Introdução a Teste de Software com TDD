função:

bool validarSenha(String senha) {
  if (senha.length < 8) {
    return false;
  }

  if (!senha.contains(RegExp(r'[A-Z]'))) {
    return false;
  }

  if (!senha.contains(RegExp(r'[0-9]'))) {
    return false;
  }

  return true;
}
